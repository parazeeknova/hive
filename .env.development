# Public local-development defaults. No manual setup is required.
# Put personal overrides and provider keys in ignored .env.local.
POSTGRES_PASSWORD=hive-local-only
DATABASE_URL=postgres://hive:hive-local-only@127.0.0.1:5432/hive
REDIS_URL=redis://127.0.0.1:6379
ZO_ROOT_USER_EMAIL=hive@localhost.test
ZO_ROOT_USER_PASSWORD=Hive-local-only-123!
RUST_LOG=info,hyper=warn,reqwest=warn,opentelemetry=warn
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:5080/api/default
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=service.namespace=hive,deployment.environment.name=development
OPENAI_API_KEY=
